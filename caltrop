#!/usr/bin/env python3
"""caltrop: keep AI-written Rust, Python and TypeScript/Svelte tests honest. See README.md."""
import ast
import configparser
import json
import posixpath
import re
import shlex
import subprocess
import sys
import tomllib
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
SGCONFIG = HERE / "sgconfig.yml"


def base_id(rule_id):
    # Per-language and per-scope variants (no-fixed-sleep-py-tests-dir) share one allowlist id, and so do
    # cases that need their own message (no-weak-result-assert.catch-ts): the part after the dot is dropped.
    return re.sub(r"(-py|-tsx|-ts|-js|-json|-svelte)?(-tests-dir)?$", "", rule_id.split(".")[0])


# assert-helper is not reported: it feeds the no-assertion-free-test filter in scan().
RULES = ({base_id(m[1]) for f in (HERE / "rules").rglob("*.yml")
          for m in [re.search(r"^id:\s*(\S+)", f.read_text(), re.M)] if m} | {"no-test-retries"}) - {"assert-helper"}
RETRY_MSG = "Make the test deterministic; a retry hides the flake."
FILTER_MSG = ("Run the whole suite in CI. Fix or delete the test you are filtering out, "
              "and let a run that finds no tests fail.")
# Keep in step with the `asserts` util in rules/python/no-assertion-free-test-py.yml.
ASSERT_CALL = re.compile(r"_*(assert|expect|fail|raises|warns|deprecated_call)", re.I)
# Config file -> the section pytest reads its options from.
PYTEST_CONFIGS = {"pytest.ini": "pytest", "tox.ini": "pytest", "setup.cfg": "tool:pytest"}
SKIP_DIRS = {"vendor", "node_modules", "site-packages"}
# A generator's header in a file's first lines: "@generated", "DO NOT EDIT", "auto-generated by openapi-ts".
GENERATED = re.compile(r"@generated\b|\bdo not edit\b|\b(auto-?)?generated (by|from|using)\b", re.I)
# Module file extensions a mocked path may carry: toast.svelte.ts, api.js, Card.svelte.
MODULE_EXT = re.compile(r"(\.(svelte|vue|[cm]?[jt]sx?))+$")
# shortcut: common alias roots only (SvelteKit $lib, @/ and ~/ for src); read tsconfig paths if users report misses.
ALIASES = {"$lib": "src/lib", "@": "src", "~": "src"}
# Bumped by each release pull request; see docs/versions.md.
VERSION = "1.6.0"
AST_GREP = "0.44.1"
INSTALL = f"install ast-grep {AST_GREP}: cargo install ast-grep --version {AST_GREP} --locked"
USAGE = ("usage: caltrop check [--format text|github] [REPO_DIR]\n"
         "       caltrop baseline [REPO_DIR]\n       caltrop --help | --version")


def die(msg):
    print(f"caltrop: {msg}", file=sys.stderr)
    sys.exit(2)


def scan(repo):
    try:
        v = subprocess.run(["ast-grep", "--version"], capture_output=True, text=True).stdout
        if v.split()[-1:] != [AST_GREP]:
            print(f"caltrop: warning: expected ast-grep {AST_GREP}, found {v.strip() or 'unknown'}; counts may differ",
                  file=sys.stderr)
        p = subprocess.run(["ast-grep", "scan", "-c", str(SGCONFIG), "--json=stream",
                            # Rule counts on stderr, so a scan that loaded no rules cannot pass.
                            "--inspect", "summary",
                            # Vendored third-party code is not this repo's to judge.
                            "--globs", "!**/vendor/**",
                            # Installed dependencies, in case they are not gitignored.
                            "--globs", "!**/node_modules/**",
                            "--globs", "!**/site-packages/**", "."],
                           cwd=repo, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"ast-grep not found; {INSTALL}")
    # ast-grep exits 1 when it finds error-level hits, so judge by output, not exit code.
    err = "\n".join(x for x in p.stderr.splitlines() if not x.startswith("sg: ")).strip()
    if p.returncode and not p.stdout.strip():
        die(f"ast-grep failed ({err}); {INSTALL}")
    loaded = re.search(r"effectiveRuleCount=(\d+)", p.stderr)
    shipped = sum(1 for _ in (HERE / "rules").rglob("*.yml"))
    if not loaded or int(loaded[1]) < shipped:
        # e.g. a .gitignore of `*` above the install makes ast-grep skip rules/ (rules/.ignore guards that case).
        die(f"ast-grep ran {loaded[1] if loaded else 'an unknown number'} of the {shipped} rules in {HERE / 'rules'}; "
            "a .gitignore or .ignore above it may hide rules/ or utils/")
    hits, calls, helpers, subject = {}, {}, set(), set()
    try:
        for line in p.stdout.splitlines():
            h = json.loads(line)
            rule = base_id(h["ruleId"])
            if rule == "assert-helper":
                helpers.add(h["metaVariables"]["single"]["NAME"]["text"])
                continue
            key = (rule, h["file"], h["range"]["start"]["line"] + 1, h["range"]["start"]["column"])
            if rule == "no-mock-subject" and not mocks_subject(
                    repo, h["file"], h["metaVariables"]["single"]["PATH"]["text"][1:-1]):
                continue
            if rule in ("no-mock-subject", "no-stubbed-gate"):
                subject.add(key[1:])
            hits[key] = h["message"]
            if rule == "no-assertion-free-test":
                # The first call is the test's own name (Python) or it/test (TS).
                calls[key] = set(re.findall(r"(\w+)\s*\(", h["text"])[1:])
    except (ValueError, KeyError, TypeError, AttributeError):
        die("unexpected ast-grep output; check the ast-grep version. " + INSTALL)
    if any(k[1].endswith(".py") for k in calls):
        helpers |= py_assert_helpers(repo)
    for key, names in calls.items():
        if names & helpers:  # the test asserts through a helper
            del hits[key]
    for loc in subject:  # one hit per call: no-mock-subject and no-stubbed-gate say more than no-mock-libs
        hits.pop(("no-mock-libs", *loc), None)
    # Generated code is the generator's to fix, not this repo's.
    generated = {f for f in {k[1] for k in hits} if is_generated(repo / f)}
    return {k: v for k, v in hits.items() if k[1] not in generated}


def is_generated(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            head = "".join(f.readline() for _ in range(5))
    except OSError:
        return False
    return bool(GENERATED.search(head))


def mocks_subject(repo, test_file, spec):
    # True when a mocked module path names the module the test file is named after: src/lib/toast.test.ts or
    # src/lib/__tests__/toast.ts mocking './toast', '../toast/index.js' or '$lib/stores/toast.svelte'.
    test_dir, base = posixpath.split(test_file)
    name = MODULE_EXT.sub("", re.sub(r"\.(test|spec)\..*$", "", base))
    home = posixpath.dirname(test_dir) if posixpath.basename(test_dir) == "__tests__" else test_dir
    subject = home if name == "index" else posixpath.join(home, name)
    segs = spec.split("/")
    segs[-1] = MODULE_EXT.sub("", segs[-1])
    if segs[-1] == "index" and len(segs) > 1:
        segs.pop()
    if segs[0] in (".", ".."):
        mocked = posixpath.normpath(posixpath.join(test_dir, *segs))
    elif segs[0] in ALIASES:
        mocked = posixpath.join(ALIASES[segs[0]], *segs[1:])
    else:
        return False  # a package: the test mocks a dependency
    if posixpath.basename(mocked) != posixpath.basename(subject):
        return False
    if ("/" + subject).endswith("/" + mocked):
        return True
    # The paths differ: a same-named module elsewhere is a dependency if the test's own module sits beside it.
    # Otherwise (a test under tests/ or __tests__ away from its module) the name is enough.
    d = repo / home
    return not (d.is_dir() and any(MODULE_EXT.sub("", p.name) == name and not re.search(r"\.(test|spec)\.", p.name)
                                   for p in d.iterdir()))


def repo_files(repo, names=None):
    # Files under repo, skipping dependency and hidden directories; names= keeps only those file names.
    for path in sorted(repo.rglob("*")):
        rel = path.relative_to(repo)
        if (names is None or path.name in names) and path.is_file() and not any(
                part in SKIP_DIRS or part.startswith(".") for part in rel.parts[:-1]):
            yield path, rel


def py_assert_helpers(repo):
    # Names of functions in Python test code that assert, directly or through another such function.
    # shortcut: matches by name across all test code, so a same-named helper elsewhere can hide a hit;
    # resolve imports if users report misses.
    fns = []
    for path, rel in repo_files(repo):
        if path.suffix != ".py" or not (re.match(r"test_|conftest\.py$", path.name) or path.name.endswith("_test.py")
                                        or {"tests", "test"} & set(rel.parts[:-1])):
            continue
        try:
            tree = ast.parse(path.read_bytes())
        except (SyntaxError, ValueError, OSError):
            continue  # newer syntax than this Python, or not Python; its helpers are not counted
        for f in ast.walk(tree):
            if isinstance(f, (ast.FunctionDef, ast.AsyncFunctionDef)):
                nodes = list(ast.walk(f))
                called = {getattr(n.func, "id", getattr(n.func, "attr", None)) for n in nodes if isinstance(n, ast.Call)}
                direct = any(isinstance(n, (ast.Assert, ast.Raise)) for n in nodes) or any(
                    ASSERT_CALL.match(c) for c in called if c)
                fns.append((f.name, called, direct))
    helpers = {name for name, _, direct in fns if direct}
    while new := {name for name, called, _ in fns if called & helpers} - helpers:
        helpers |= new
    return helpers


def retry_hits(repo):
    path = repo / ".config" / "nextest.toml"
    if not path.is_file():
        return {}
    text = path.read_text()
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f"{path}: {e}")
    # Map each retries key to its table: (profile, override index or None) -> line.
    lines, sec, seen = {}, None, {}
    for i, l in enumerate(text.splitlines(), 1):
        m = re.match(r"\s*\[(\[)?\s*profile\.([^.\]\s]+)(\.overrides)?\s*\]", l)
        if m:
            name = m[2].strip("\"'")
            seen[name] = seen.get(name, -1) + (1 if m[3] else 0)
            sec = (name, seen[name] if m[3] else None)
        elif re.match(r"\s*\[", l):
            sec = None
        elif sec and re.match(r"\s*retries\b", l):
            lines.setdefault(sec, i)
    hits = {}
    for name, profile in data.get("profile", {}).items():
        for idx, item in [(None, profile), *enumerate(profile.get("overrides", []))]:
            if "retries" not in item:
                continue
            r = item["retries"]
            count = r.get("count", 0) if isinstance(r, dict) else r
            if count > 0:
                hits[("no-test-retries", ".config/nextest.toml", lines.get((name, idx), 1), 0)] = RETRY_MSG
    return hits


def reruns(opts):
    # pytest-rerunfailures: "--reruns 2", "--reruns=2", or the same as a TOML list.
    tokens = shlex.split(opts) if isinstance(opts, str) else [str(t) for t in opts]
    for i, t in enumerate(tokens):
        val = t.removeprefix("--reruns=") if t.startswith("--reruns=") else (
            tokens[i + 1] if t == "--reruns" and i + 1 < len(tokens) else None)
        if val is not None and val.isdigit() and int(val) > 0:
            return True
    return False


def pytest_filter(opts):
    # addopts that drop tests from every run: --deselect, --ignore, --ignore-glob, -k EXPR. -m is left alone:
    # selecting by marker is how a suite is split into CI jobs.
    tokens = shlex.split(opts) if isinstance(opts, str) else [str(t) for t in opts]
    for t in tokens:
        if t.split("=")[0] in ("--deselect", "--ignore", "--ignore-glob"):
            return t.split("=")[0]
        if t.startswith("-k"):
            return "-k"
    return None


def option_line(text, key):
    # First uncommented line naming the option, for the report; the parse above decides the hit.
    for i, l in enumerate(text.splitlines(), 1):
        if re.search(rf"(?<![\w-]){re.escape(key)}", l) and not l.lstrip().startswith(("#", ";")):
            return i
    return 1


def pytest_hits(repo):
    # no-test-retries and no-test-filter in pytest config files.
    hits = {}
    for path, rel in repo_files(repo, (*PYTEST_CONFIGS, "pyproject.toml")):
        text = path.read_text()
        try:
            if path.name == "pyproject.toml":
                opts = tomllib.loads(text).get("tool", {}).get("pytest", {}).get("ini_options", {})
            else:
                cp = configparser.ConfigParser(interpolation=None)
                cp.read_string(text)
                sec = PYTEST_CONFIGS[path.name]
                opts = dict(cp[sec]) if cp.has_section(sec) else {}
        except (tomllib.TOMLDecodeError, configparser.Error):
            continue  # not ours to validate; pytest reports a broken config itself
        r = str(opts.get("reruns", "0")).strip()
        if reruns(opts.get("addopts", "")):
            hits[("no-test-retries", rel.as_posix(), option_line(text, "--reruns"), 0)] = RETRY_MSG
        elif r.isdigit() and int(r) > 0:
            hits[("no-test-retries", rel.as_posix(), option_line(text, "reruns"), 0)] = RETRY_MSG
        if flag := pytest_filter(opts.get("addopts", "")):
            hits[("no-test-filter", rel.as_posix(), option_line(text, flag), 0)] = FILTER_MSG
    return hits


def all_hits(repo):
    return {**scan(repo), **retry_hits(repo), **pytest_hits(repo)}


def counts(hits):
    return Counter((rule, file) for rule, file, *_ in hits)


def baseline(repo):
    by_rule = {}
    for (rule, file), n in sorted(counts(all_hits(repo)).items()):
        by_rule.setdefault(rule, []).append((file, n))
    out = []
    for rule, files in by_rule.items():
        out.append(f"[allow.{rule}]")
        for file, n in files:
            esc = file.replace("\\", "\\\\").replace('"', '\\"')
            out.append(f'"{esc}" = {n}')
        out.append("")
    (repo / "caltrop.toml").write_text("\n".join(out))
    print(f"caltrop: wrote {repo / 'caltrop.toml'}")


def gh_escape(s, prop=False):
    # GitHub workflow command escaping; property values also escape ':' and ','.
    s = s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    return s.replace(":", "%3A").replace(",", "%2C") if prop else s


def report(lines, fmt):
    # Each line is (file, line, col, text); file is None for allowance problems and advice.
    if fmt == "text":
        # A summary, then each rule's message once over its hits; a rule's dotted variants may add messages.
        by_rule = {}
        for file, line, _, text in sorted(x for x in lines if x[0]):
            rule, msg = text.split(": ", 1)
            by_rule.setdefault(rule, []).append((file, line, msg))
        rules = sorted(by_rule.items(), key=lambda kv: (-len(kv[1]), kv[0]))
        rows = rules + [("total", [h for _, hs in rules for h in hs])] if rules else []
        w = max((len(r) for r, _ in rows), default=0)
        nw = max((len(str(len(hs))) for _, hs in rows), default=0)
        for rule, hs in rows:
            print(f"{rule:<{w}}  {len(hs):>{nw}} hit(s) in {len({h[0] for h in hs})} file(s)")
        for rule, hs in rules:
            for msg in dict.fromkeys(h[2] for h in hs):
                print(f"\n{rule}: {msg}")
                print("\n".join(f"{file}:{line}: {rule}" for file, line, m in hs if m == msg))
        print("\n" * bool(rules) + "\n".join(text for file, _, _, text in lines if not file))
        return
    for file, line, col, text in lines:
        if file:
            print(f"::error file={gh_escape(file, True)},line={line},col={col + 1}::{gh_escape(text)}")
        else:
            print(f"::error file=caltrop.toml::{gh_escape(text)}")


def check(repo, fmt="text"):
    toml = repo / "caltrop.toml"
    try:
        allow = tomllib.loads(toml.read_text()).get("allow", {}) if toml.is_file() else {}
    except tomllib.TOMLDecodeError as e:
        die(f"{toml}: {e}")
    if not (isinstance(allow, dict) and all(
            isinstance(files, dict) and all(
                type(n) is int and n >= 0 for n in files.values())
            for files in allow.values())):
        die(f"{toml}: expected [allow.<rule>] tables of \"file\" = count (non-negative integers)")
    hits = all_hits(repo)
    have = counts(hits)
    problems = []
    for rule in allow:
        if rule not in RULES:
            problems.append((None, 0, 0, f"unknown rule in caltrop.toml: {rule}"))
    over = 0
    for (rule, file, line, col), msg in sorted(hits.items(), key=lambda kv: (kv[0][1], kv[0][2], kv[0][3], kv[0][0])):
        if have[(rule, file)] > allow.get(rule, {}).get(file, 0):
            problems.append((file, line, col, f"{rule}: {msg}"))
            over += 1
    for rule, files in allow.items():
        if rule not in RULES:
            continue
        for file, allowed in files.items():
            n = have[(rule, file)]
            if n < allowed:
                if (repo / file).exists():
                    problems.append((None, 0, 0, f"lower the allowance for {rule} in {file} to {n}"))
                else:
                    problems.append((None, 0, 0,
                                     f"lower the allowance for {rule} in {file} to 0: file no longer exists"))
    if problems:
        edit = over < len(problems)
        if not toml.is_file():
            problems.append((None, 0, 0, "run caltrop baseline to adopt caltrop in this repo"))
        else:
            if over:
                problems.append((None, 0, 0, "fix these hits; do not raise counts in caltrop.toml"))
            if edit:
                problems.append((None, 0, 0, "edit caltrop.toml as shown"))
        report(problems, fmt)
        return 1
    print(f"caltrop: ok, {len(hits)} allowed hit(s)")
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv  # None: called as the pipx entry point
    if not argv or argv[0] in ("-h", "--help"):
        print(f"{USAGE}\n\ncheck: fail on test shortcuts beyond caltrop.toml\n"
              "  --format github: print hits as GitHub Actions error annotations\n"
              "baseline: write caltrop.toml from the current hits (adoption only)")
        return 0 if argv else 2
    if argv[0] == "--version":
        print(f"caltrop {VERSION}")
        return 0
    fmt = "text"
    if argv[0] == "check" and "--format" in argv[1:]:
        i = argv.index("--format")
        fmt = argv[i + 1] if i + 1 < len(argv) else None
        argv = argv[:i] + argv[i + 2:]
    if argv[0] not in ("check", "baseline") or len(argv) > 2 or fmt not in ("text", "github"):
        print(USAGE, file=sys.stderr)
        return 2
    repo = Path(argv[1] if len(argv) > 1 else ".").resolve()
    if not repo.is_dir():
        die(f"not a directory: {repo}")
    return check(repo, fmt) if argv[0] == "check" else baseline(repo) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
