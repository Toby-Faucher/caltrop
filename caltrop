#!/usr/bin/env python3
"""caltrop: keep AI-written Rust, Python and TypeScript/Svelte tests honest. See README.md."""
import configparser
import json
import re
import shlex
import subprocess
import sys
import tomllib
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
SGCONFIG = HERE / "sgconfig.yml"


def base_id(rule_id):
    # Per-language and per-scope variants (no-fixed-sleep-py-tests-dir) share one allowlist id, and so do
    # cases that need their own message (no-weak-result-assert.catch-ts): the part after the dot is dropped.
    return re.sub(r"(-py|-tsx|-ts|-js|-svelte)?(-tests-dir)?$", "", rule_id.split(".")[0])


RULES = {base_id(m[1]) for f in (HERE / "rules").rglob("*.yml")
         for m in [re.search(r"^id:\s*(\S+)", f.read_text(), re.M)] if m} | {"no-test-retries"}
RETRY_MSG = "Make the test deterministic; a retry hides the flake."
# Config file -> the section pytest reads its options from.
PYTEST_CONFIGS = {"pytest.ini": "pytest", "tox.ini": "pytest", "setup.cfg": "tool:pytest"}
SKIP_DIRS = {"vendor", "node_modules", "site-packages"}
# Bumped by each release pull request; see docs/versions.md.
VERSION = "1.1.0"
AST_GREP = "0.44.1"
INSTALL = f"install ast-grep {AST_GREP}: cargo install ast-grep --version {AST_GREP} --locked"
USAGE = ("usage: caltrop check [--format text|github] [REPO_DIR]\n"
         "       caltrop baseline [REPO_DIR]\n       caltrop --help | --version")


def die(msg):
    print(f"caltrop: {msg}", file=sys.stderr)
    sys.exit(2)


def scan(repo):
    try:
        v = subprocess.run(["ast-grep", "--version"], capture_output=True, text=True).stdout
        if v.split()[-1:] != [AST_GREP]:
            print(f"caltrop: warning: expected ast-grep {AST_GREP}, found {v.strip() or 'unknown'}; counts may differ",
                  file=sys.stderr)
        p = subprocess.run(["ast-grep", "scan", "-c", str(SGCONFIG), "--json=stream",
                            # Vendored third-party code is not this repo's to judge.
                            "--globs", "!**/vendor/**",
                            # Installed dependencies, in case they are not gitignored.
                            "--globs", "!**/node_modules/**",
                            "--globs", "!**/site-packages/**", "."],
                           cwd=repo, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"ast-grep not found; {INSTALL}")
    # ast-grep exits 1 when it finds error-level hits, so judge by output, not exit code.
    if p.returncode and not p.stdout.strip():
        die(f"ast-grep failed ({p.stderr.strip()}); {INSTALL}")
    hits = {}
    try:
        for line in p.stdout.splitlines():
            h = json.loads(line)
            rule = base_id(h["ruleId"])
            hits[(rule, h["file"], h["range"]["start"]["line"] + 1, h["range"]["start"]["column"])] = h["message"]
    except (ValueError, KeyError, TypeError, AttributeError):
        die("unexpected ast-grep output; check the ast-grep version. " + INSTALL)
    return hits


def retry_hits(repo):
    path = repo / ".config" / "nextest.toml"
    if not path.is_file():
        return {}
    text = path.read_text()
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f"{path}: {e}")
    # Map each retries key to its table: (profile, override index or None) -> line.
    lines, sec, seen = {}, None, {}
    for i, l in enumerate(text.splitlines(), 1):
        m = re.match(r"\s*\[(\[)?\s*profile\.([^.\]\s]+)(\.overrides)?\s*\]", l)
        if m:
            name = m[2].strip("\"'")
            seen[name] = seen.get(name, -1) + (1 if m[3] else 0)
            sec = (name, seen[name] if m[3] else None)
        elif re.match(r"\s*\[", l):
            sec = None
        elif sec and re.match(r"\s*retries\b", l):
            lines.setdefault(sec, i)
    hits = {}
    for name, profile in data.get("profile", {}).items():
        for idx, item in [(None, profile), *enumerate(profile.get("overrides", []))]:
            if "retries" not in item:
                continue
            r = item["retries"]
            count = r.get("count", 0) if isinstance(r, dict) else r
            if count > 0:
                hits[("no-test-retries", ".config/nextest.toml", lines.get((name, idx), 1), 0)] = RETRY_MSG
    return hits


def reruns(opts):
    # pytest-rerunfailures: "--reruns 2", "--reruns=2", or the same as a TOML list.
    tokens = shlex.split(opts) if isinstance(opts, str) else [str(t) for t in opts]
    for i, t in enumerate(tokens):
        val = t.removeprefix("--reruns=") if t.startswith("--reruns=") else (
            tokens[i + 1] if t == "--reruns" and i + 1 < len(tokens) else None)
        if val is not None and val.isdigit() and int(val) > 0:
            return True
    return False


def option_line(text, key):
    # First uncommented line naming the option, for the report; the parse above decides the hit.
    for i, l in enumerate(text.splitlines(), 1):
        if key in l and not l.lstrip().startswith(("#", ";")):
            return i
    return 1


def pytest_retry_hits(repo):
    hits = {}
    for path in sorted(repo.rglob("*")):
        rel = path.relative_to(repo)
        if path.name not in (*PYTEST_CONFIGS, "pyproject.toml") or not path.is_file() or any(
                part in SKIP_DIRS or part.startswith(".") for part in rel.parts[:-1]):
            continue
        text = path.read_text()
        try:
            if path.name == "pyproject.toml":
                opts = tomllib.loads(text).get("tool", {}).get("pytest", {}).get("ini_options", {})
            else:
                cp = configparser.ConfigParser(interpolation=None)
                cp.read_string(text)
                sec = PYTEST_CONFIGS[path.name]
                opts = dict(cp[sec]) if cp.has_section(sec) else {}
        except (tomllib.TOMLDecodeError, configparser.Error):
            continue  # not ours to validate; pytest reports a broken config itself
        r = str(opts.get("reruns", "0")).strip()
        if reruns(opts.get("addopts", "")):
            hits[("no-test-retries", rel.as_posix(), option_line(text, "--reruns"), 0)] = RETRY_MSG
        elif r.isdigit() and int(r) > 0:
            hits[("no-test-retries", rel.as_posix(), option_line(text, "reruns"), 0)] = RETRY_MSG
    return hits


def all_hits(repo):
    return {**scan(repo), **retry_hits(repo), **pytest_retry_hits(repo)}


def counts(hits):
    return Counter((rule, file) for rule, file, *_ in hits)


def baseline(repo):
    by_rule = {}
    for (rule, file), n in sorted(counts(all_hits(repo)).items()):
        by_rule.setdefault(rule, []).append((file, n))
    out = []
    for rule, files in by_rule.items():
        out.append(f"[allow.{rule}]")
        for file, n in files:
            esc = file.replace("\\", "\\\\").replace('"', '\\"')
            out.append(f'"{esc}" = {n}')
        out.append("")
    (repo / "caltrop.toml").write_text("\n".join(out))
    print(f"caltrop: wrote {repo / 'caltrop.toml'}")


def gh_escape(s, prop=False):
    # GitHub workflow command escaping; property values also escape ':' and ','.
    s = s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    return s.replace(":", "%3A").replace(",", "%2C") if prop else s


def report(lines, fmt):
    # Each line is (file, line, col, text); file is None for allowance problems and advice.
    for file, line, col, text in lines:
        if fmt == "text":
            print(f"{file}:{line}: {text}" if file else text)
        elif file:
            print(f"::error file={gh_escape(file, True)},line={line},col={col + 1}::{gh_escape(text)}")
        else:
            print(f"::error file=caltrop.toml::{gh_escape(text)}")


def check(repo, fmt="text"):
    toml = repo / "caltrop.toml"
    try:
        allow = tomllib.loads(toml.read_text()).get("allow", {}) if toml.is_file() else {}
    except tomllib.TOMLDecodeError as e:
        die(f"{toml}: {e}")
    if not (isinstance(allow, dict) and all(
            isinstance(files, dict) and all(
                type(n) is int and n >= 0 for n in files.values())
            for files in allow.values())):
        die(f"{toml}: expected [allow.<rule>] tables of \"file\" = count (non-negative integers)")
    hits = all_hits(repo)
    have = counts(hits)
    problems = []
    for rule in allow:
        if rule not in RULES:
            problems.append((None, 0, 0, f"unknown rule in caltrop.toml: {rule}"))
    over = 0
    for (rule, file, line, col), msg in sorted(hits.items(), key=lambda kv: (kv[0][1], kv[0][2], kv[0][3], kv[0][0])):
        if have[(rule, file)] > allow.get(rule, {}).get(file, 0):
            problems.append((file, line, col, f"{rule}: {msg}"))
            over += 1
    for rule, files in allow.items():
        if rule not in RULES:
            continue
        for file, allowed in files.items():
            n = have[(rule, file)]
            if n < allowed:
                if (repo / file).exists():
                    problems.append((None, 0, 0, f"lower the allowance for {rule} in {file} to {n}"))
                else:
                    problems.append((None, 0, 0,
                                     f"lower the allowance for {rule} in {file} to 0: file no longer exists"))
    if problems:
        edit = over < len(problems)
        if not toml.is_file():
            problems.append((None, 0, 0, "run caltrop baseline to adopt caltrop in this repo"))
        else:
            if over:
                problems.append((None, 0, 0, "fix these hits; do not raise counts in caltrop.toml"))
            if edit:
                problems.append((None, 0, 0, "edit caltrop.toml as shown"))
        report(problems, fmt)
        return 1
    print(f"caltrop: ok, {len(hits)} allowed hit(s)")
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv  # None: called as the pipx entry point
    if not argv or argv[0] in ("-h", "--help"):
        print(f"{USAGE}\n\ncheck: fail on test shortcuts beyond caltrop.toml\n"
              "  --format github: print hits as GitHub Actions error annotations\n"
              "baseline: write caltrop.toml from the current hits (adoption only)")
        return 0 if argv else 2
    if argv[0] == "--version":
        print(f"caltrop {VERSION}")
        return 0
    fmt = "text"
    if argv[0] == "check" and "--format" in argv[1:]:
        i = argv.index("--format")
        fmt = argv[i + 1] if i + 1 < len(argv) else None
        argv = argv[:i] + argv[i + 2:]
    if argv[0] not in ("check", "baseline") or len(argv) > 2 or fmt not in ("text", "github"):
        print(USAGE, file=sys.stderr)
        return 2
    repo = Path(argv[1] if len(argv) > 1 else ".").resolve()
    if not repo.is_dir():
        die(f"not a directory: {repo}")
    return check(repo, fmt) if argv[0] == "check" else baseline(repo) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
