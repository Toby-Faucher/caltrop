#!/usr/bin/env python3
"""caltrop: keep AI-written Rust tests honest. See README.md."""
import json
import re
import subprocess
import sys
import tomllib
from collections import Counter
from pathlib import Path

SGCONFIG = Path(__file__).resolve().parent / "sgconfig.yml"
RULES = {"no-fixed-sleep", "no-deadline-poll", "no-test-swap", "no-mock-crates", "no-test-retries"}
RETRY_MSG = "Make the test deterministic; a retry hides the flake."
INSTALL = "install ast-grep 0.44.1: cargo install ast-grep --version 0.44.1 --locked"
USAGE = "usage: caltrop {check|baseline} [REPO_DIR]\n       caltrop --help"


def die(msg):
    print(f"caltrop: {msg}", file=sys.stderr)
    sys.exit(2)


def scan(repo):
    try:
        p = subprocess.run(["ast-grep", "scan", "-c", str(SGCONFIG), "--json=stream", "."],
                           cwd=repo, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"ast-grep not found; {INSTALL}")
    # ast-grep exits 1 when it finds error-level hits, so judge by output, not exit code.
    if p.returncode and not p.stdout.strip():
        die(f"ast-grep failed ({p.stderr.strip()}); {INSTALL}")
    hits = {}
    try:
        for line in p.stdout.splitlines():
            h = json.loads(line)
            rule = h["ruleId"].removesuffix("-tests-dir")
            hits[(rule, h["file"], h["range"]["start"]["line"] + 1)] = h["message"]
    except (ValueError, KeyError, TypeError, AttributeError):
        die("unexpected ast-grep output; check the ast-grep version. " + INSTALL)
    return hits


def retry_hits(repo):
    path = repo / ".config" / "nextest.toml"
    if not path.is_file():
        return {}
    text = path.read_text()
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f"{path}: {e}")
    lines = [i + 1 for i, l in enumerate(text.splitlines()) if re.match(r"\s*retries\b", l)]
    hits, n = {}, 0
    for profile in data.get("profile", {}).values():
        for item in [profile, *profile.get("overrides", [])]:
            if "retries" not in item:
                continue
            r = item["retries"]
            count = r.get("count", 0) if isinstance(r, dict) else r
            lineno = lines[n] if n < len(lines) else 1
            n += 1
            if count > 0:
                hits[("no-test-retries", ".config/nextest.toml", lineno)] = RETRY_MSG
    return hits


def counts(hits):
    return Counter((rule, file) for rule, file, _ in hits)


def baseline(repo):
    by_rule = {}
    for (rule, file), n in sorted(counts({**scan(repo), **retry_hits(repo)}).items()):
        by_rule.setdefault(rule, []).append((file, n))
    out = []
    for rule, files in by_rule.items():
        out.append(f"[allow.{rule}]")
        for file, n in files:
            esc = file.replace("\\", "\\\\").replace('"', '\\"')
            out.append(f'"{esc}" = {n}')
        out.append("")
    (repo / "caltrop.toml").write_text("\n".join(out))
    print(f"caltrop: wrote {repo / 'caltrop.toml'}")


def check(repo):
    toml = repo / "caltrop.toml"
    try:
        allow = tomllib.loads(toml.read_text()).get("allow", {}) if toml.is_file() else {}
    except tomllib.TOMLDecodeError as e:
        die(f"{toml}: {e}")
    if not (isinstance(allow, dict) and all(
            isinstance(files, dict) and all(
                type(n) is int and n >= 0 for n in files.values())
            for files in allow.values())):
        die(f"{toml}: expected [allow.<rule>] tables of \"file\" = count (non-negative integers)")
    hits = {**scan(repo), **retry_hits(repo)}
    have = counts(hits)
    problems = []
    for rule in allow:
        if rule not in RULES:
            problems.append(f"unknown rule in caltrop.toml: {rule}")
    for (rule, file, line), msg in sorted(hits.items(), key=lambda kv: (kv[0][1], kv[0][2], kv[0][0])):
        if have[(rule, file)] > allow.get(rule, {}).get(file, 0):
            problems.append(f"{file}:{line}: {rule}: {msg}")
    for rule, files in allow.items():
        if rule not in RULES:
            continue
        for file, allowed in files.items():
            n = have[(rule, file)]
            if n < allowed:
                if (repo / file).exists():
                    problems.append(f"lower the allowance for {rule} in {file} to {n}")
                else:
                    problems.append(f"lower the allowance for {rule} in {file} to 0: file no longer exists")
    if problems:
        print("\n".join(problems))
        if not toml.is_file():
            print("run caltrop baseline to adopt caltrop in this repo")
        else:
            print("fix the hits, or run caltrop baseline only to adopt caltrop in a new repo")
        return 1
    print(f"caltrop: ok, {len(hits)} allowed hit(s)")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(f"{USAGE}\n\ncheck: fail on test shortcuts beyond caltrop.toml\n"
              "baseline: write caltrop.toml from the current hits (adoption only)")
        return 0 if argv else 2
    if argv[0] not in ("check", "baseline") or len(argv) > 2:
        print(USAGE, file=sys.stderr)
        return 2
    repo = Path(argv[1] if len(argv) > 1 else ".").resolve()
    if not repo.is_dir():
        die(f"not a directory: {repo}")
    return check(repo) if argv[0] == "check" else baseline(repo) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
